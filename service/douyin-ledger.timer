[Unit]
Description=Run Douyin Live Ledger every 10 minutes

[Timer]
# 开机 5 分钟后先跑一次（等网络与守护进程起来）。比体检的 3 分钟晚一点：
# 守护进程重启后的头几分钟本来就在探在播、开新场次，太早跑会把「刚开始写」的
# 场次算进统计里，噪声大。
OnBootSec=5min
# 之后每 10 分钟一次。**2026-10-16 从 30 分钟改过来**：守护进程现在并发只采 10 个
# 主播，**其余 147 人不再落任何数据**，台账成了他们唯一的开播状态记录 —— 30 分钟的
# 粒度对「记录谁开播了」太粗。与体检同频（10 分钟）。
# 「疑似漏采」按**连续 ≥2 轮**计，所以一次漏采最迟 20 分钟内会被报出来。
# 一轮探测实测约 6 分钟（含限流），所以这个周期已经接近下限，**不要再往下调**。
OnUnitActiveSec=10min
# 关机期间错过的轮次，开机后补跑一次。**这一条对本单元尤其重要**：
# 漏采是「错过就永久丢掉整场数据」的事，补跑一轮能立刻把「哪些主播在播、
# 哪些场次没在采」的状态补齐。
Persistent=true

[Install]
WantedBy=timers.target
