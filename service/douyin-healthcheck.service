[Unit]
Description=Douyin Live Crawl Health Check (one-shot, 产出体检)
After=network-online.target
Wants=network-online.target

[Service]
# Type=oneshot：跑完就退，**退出码就是判定**（0 健康 / 1 down|stale）。
# 于是 `systemctl --failed` 会直接列出它 —— 这就是我们要的告警面，
# 不需要自己造邮件/钉钉告警通道（也没有那些基础设施）。
Type=oneshot
User=root
WorkingDirectory=/opt/douyin-live
ExecStart=/opt/douyin-live/venv/bin/python /opt/douyin-live/service/health_check.py

# 和 douyin-crawl 读**同一份**代理配置 —— 体检探的必须是被守护进程实际使用的那条隧道，
# 否则会出现「体检说通、采集在空转」这种最误导人的组合。
EnvironmentFile=-/opt/douyin-live/config/proxy.env
Environment=PYTHONUNBUFFERED=1

# ⚠️ **不要**加 Restart=always：这是跑完即退的单元，加上会变成死循环刷 journal，
# 把真日志挤掉。也**不要**加 Restart=on-failure：失败正是要留下的信号，重试会把
# 退出码冲成成功，`systemctl --failed` 就看不见了。

StandardOutput=journal
StandardError=journal
SyslogIdentifier=douyin-healthcheck

# 探 8 个房间 + 名单读一遍，正常几秒；给足余量但不无限等（隧道半死时 socket 会挂很久）
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
